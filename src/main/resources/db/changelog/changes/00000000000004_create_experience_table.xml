<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
            id="00000000000004_create_experience_table"
            author="jade">

        <createTable
                schemaName="portfolio"
                tableName="experience">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_experience"/>
            </column>

            <column
                    name="public_id"
                    type="UUID"
                    defaultValueComputed="gen_random_uuid()">
                <constraints
                        nullable="false"
                        unique="true"
                        uniqueConstraintName="uk_experience_public_id"/>
            </column>

            <column name="profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="job_title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="company_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="location" type="VARCHAR(255)"/>

            <column name="start_year" type="SMALLINT">
                <constraints nullable="false"/>
            </column>

            <column name="start_month" type="SMALLINT"/>

            <column name="end_year" type="SMALLINT"/>

            <column name="end_month" type="SMALLINT"/>

            <column
                    name="current_position"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT"/>

            <column
                    name="display_order"
                    type="INTEGER"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column
                    name="created_date"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="last_modified_date"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_experience_profile"
                baseTableSchemaName="portfolio"
                baseTableName="experience"
                baseColumnNames="profile_id"
                referencedTableSchemaName="portfolio"
                referencedTableName="portfolio_profile"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex
                schemaName="portfolio"
                tableName="experience"
                indexName="idx_experience_profile_display_order">
            <column name="profile_id"/>
            <column name="display_order"/>
        </createIndex>

        <loadData
                schemaName="portfolio"
                file="db/changelog/data/jade_kearns_experience.csv"
                separator="|"
                quotchar="&quot;"
                encoding="UTF-8"
                tableName="experience"
                usePreparedStatements="true">

            <column
                    header="id"
                    name="id"
                    type="skip"/>

            <column
                    header="public_id"
                    name="public_id"
                    type="skip"/>

            <column
                    header="created_date"
                    name="created_date"
                    type="skip"/>

            <column
                    header="last_modified_date"
                    name="last_modified_date"
                    type="skip"/>

        </loadData>

        <rollback>
            <dropTable
                    schemaName="portfolio"
                    tableName="experience"/>
        </rollback>

    </changeSet>

</databaseChangeLog>